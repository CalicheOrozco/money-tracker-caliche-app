# Copy to .env and fill in. Never prefix these with VITE_, that would ship them to the browser.
MONGODB_URI=
MONGODB_DB=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Push notifications. Generate the keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects the daily notification job, any long random string
CRON_SECRET=

# Logo search client id from developers.brandfetch.com (served to the browser at runtime)
BRANDFETCH_CLIENT_ID=
# Brand colors for cards (secret, server only). Brand API key from developers.brandfetch.com
BRANDFETCH_API_KEY=
